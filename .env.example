# =====================================================================
#  إعدادات المنصة - انسخ هذا الملف باسم .env وعدّل القيم
#  cp .env.example .env
#  تحذير: لا ترفع ملف .env إلى GitHub أبداً (مضاف في .gitignore)
# =====================================================================

# ----------------------- إعدادات عامة -----------------------
APP_NAME="منصة الرخصة المهنية"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/professional-license
APP_TIMEZONE=Asia/Riyadh
APP_KEY=
APP_PRETTY_URLS=true
APP_MAINTENANCE=false

# ----------------------- قاعدة البيانات ---------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=professional_license
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ----------------------- الجلسات ----------------------------
SESSION_NAME=pl_session
SESSION_LIFETIME=180
SESSION_SECURE=false
SESSION_SAMESITE=Lax

# ----------------------- الاشتراك ---------------------------
SUBSCRIPTION_PRICE=100
SUBSCRIPTION_DAYS=365

# ----------------------- تلجرام -----------------------------
# لا تضع التوكن في الكود - فقط هنا أو في متغيرات البيئة الخاصة بالاستضافة
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# ------------------ بوابات الدفع السعودية -------------------
# تعمل المنصة افتراضياً بالدفع اليدوي (تحويل بنكي + رفع إثبات)
PAYMENT_MANUAL_ENABLED=true

# Moyasar (مدى / Apple Pay / STC Pay / فيزا)
MOYASAR_ENABLED=false
MOYASAR_PUBLIC_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# MyFatoorah
MYFATOORAH_ENABLED=false
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com

# Tap (اختياري للمستقبل)
TAP_ENABLED=false
TAP_SECRET_KEY=

# ----------------------- OTP / الرسائل ----------------------
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER=

# ----------------------- البريد -----------------------------
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="منصة الرخصة المهنية"

# ----------------------- رفع الملفات ------------------------
UPLOAD_MAX_MB=8
